# platform-probe — example environment configuration.
# Copy to `.env` and adjust. All values are optional; the defaults shown work for
# a standard in-cluster deployment.

# HTTP listen port (optional; default 8080).
PORT=8080

# Time between server-side probe cycles (optional; default 15s). Because clients
# only read the cached snapshot, this also sets how fresh that snapshot is.
PROBE_INTERVAL=15s

# Per-probe timeout (optional; default 5s). Must be shorter than PROBE_INTERVAL so
# a slow cycle cannot overrun the next one.
PROBE_TIMEOUT=5s

# Path to the JSON checks file (optional; default shown). It is loaded — and
# RE-loaded every probe cycle — at runtime, so it is never compiled into the
# binary. In the cluster this is a SOPS-encrypted Secret mounted as a directory;
# editing the Secret updates the checks live. See config.example.json for the shape.
CHECKS_CONFIG_FILE=/etc/platform-probe/checks.json

# Log verbosity: debug | info | warn | error (optional; default info).
LOG_LEVEL=info
